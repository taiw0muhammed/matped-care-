# ─────────────────────────────────────────────────────────────────────────────
# MatPed Care — environment variables
# Copy to .env.local for local development. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────────────
# Project settings → API. The anon key is public by design and safe for the
# browser; all authorization is enforced by Postgres Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER used in client components. Required for the reminder
# engine (cron), PDF record generation and the Gemini explanation layer.
# Without it the app still works; server-side background features report
# "not configured" instead of failing silently.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Gemini (optional) ─────────────────────────────────────────────────
# Server-only. AI growth insight is an assistive explanation layer on top of
# the validated growth engine. When unset, insights show a clear
# "AI insight not configured" state and everything else keeps working.
GEMINI_API_KEY=
# e.g. gemini-2.5-flash
GEMINI_MODEL=

# ── Notification providers (optional, server-only) ───────────────────────────
# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Email (any SendGrid-compatible SMTP API)
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
# WhatsApp (e.g. Twilio WhatsApp sender)
WHATSAPP_SENDER_ID=

# ── App ──────────────────────────────────────────────────────────────────────
# Base URL used in email/SMS links (Vercel deployment URL in production).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Reminder engine (Vercel Cron) ────────────────────────────────────────────
# Secret header value the cron uses to call /api/cron/reminders.
CRON_SECRET=